<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <NoWarn>$(NoWarn);RS1036;RS2008</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\Shared\GraphCSharpRuleSet.cs" Link="Shared\GraphCSharpRuleSet.cs" />
        <Compile Include="..\Shared\GraphCSharpBindingRegistry.cs" Link="Shared\GraphCSharpBindingRegistry.cs" />
        <Compile Include="..\Shared\GraphCSharpRestrictionAnalyzer.cs" Link="Shared\GraphCSharpRestrictionAnalyzer.cs" />
    </ItemGroup>

</Project>
